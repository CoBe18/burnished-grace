RewriteEngine On

# Send www.burnishedgracestudio.com to the one main address, so Google
# sees a single copy of each page instead of two.
RewriteCond %{HTTP_HOST} ^www\.burnishedgracestudio\.com$ [NC]
RewriteRule ^ https://burnishedgracestudio.com%{REQUEST_URI} [L,R=301]

RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Always check for the newest version of pages, styles and scripts,
# so site changes show up right away without clearing the browser.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>